{
  "name": "@surgio/packages-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "turbo run test",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "coverage": "turbo run test:cov",
    "test:e2e": "pnpm --filter @surgio/gateway test:e2e",
    "test:types": "run-s test:types:ts6 test:types:ts7",
    "test:types:ts6": "tsc6 -b --noEmit",
    "test:types:ts7": "tsc -b --noEmit",
    "test:package-output": "vitest run --config vitest.package-output.config.mts",
    "prepublishOnly": "turbo run build",
    "lerna": "lerna",
    "prepare": "husky",
    "release": "lerna version && lerna publish from-git",
    "release:beta": "lerna version --conventional-prerelease --preid beta && lerna publish from-git --dist-tag beta"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-angular": "^21.2.2",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-istanbul": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lerna": "^10.0.0",
    "lint-staged": "^17.3.0",
    "npm-debug-log-cleaner": "^1.0.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "surgio": "4.0.0-beta.7",
    "turbo": "^2.10.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "repository": "https://github.com/surgioproject/packages",
  "author": "Roy Li <me@royli.dev>",
  "bugs": {
    "url": "https://github.com/surgioproject/surgio/issues"
  },
  "homepage": "https://surgio.js.org",
  "engines": {
    "node": ">=22.22.2"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}