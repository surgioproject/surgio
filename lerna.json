{
  "command": {
    "version": {
      "conventionalCommits": true,
      "message": "chore(release): new release"
    },
    "publish": {
      "ignoreScripts": true
    }
  },
  "ignoreChanges": [
    "**/__fixtures__/**",
    "**/__tests__/**",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.md",
    "packages/surgio/test/**",
    "packages/surgio/examples/**"
  ],
  "version": "independent",
  "npmClient": "pnpm"
}
