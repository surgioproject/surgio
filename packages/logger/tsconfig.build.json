{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "sourceMap": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/__tests__/__fixtures__",
    "eslint.config.mjs",
    "*.mjs"
  ]
}
